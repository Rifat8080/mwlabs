<% content_for :title, "Contact | M&W Labs" %>
<% content_for :meta_description, "Contact M&W Labs to apply for an MVP partnership, request a complimentary growth report, book a strategy call, or get a project quote." %>

<section class="studio-inner-hero">
  <div class="studio-wrap">
    <p class="studio-section-label">Contact / Project enquiry</p>
    <h1 class="studio-display studio-inner-title">Turn the problem into a plan.</h1>
    <p class="studio-inner-lede">Apply for an MVP partnership, request a complimentary marketing report, or ask for a project quote. Every enquiry is routed into our CRM for a clear response.</p>
  </div>
</section>

<section class="studio-section">
  <div class="studio-wrap studio-contact-grid">
    <div>
      <p class="studio-section-label">What happens next</p>
      <div class="studio-principles">
        <% [
          [ "01", "Review", "We check the goal, scope, timing and whether we are the right team." ],
          [ "02", "Route", "Your enquiry enters the CRM and a client portal is prepared from your email." ],
          [ "03", "Respond", "We send the next practical step: a call, quote, report or a direct recommendation." ]
        ].each do |index, title, body| %>
          <article class="studio-principle">
            <span class="studio-utility"><%= index %></span>
            <h2><%= title %></h2>
            <p><%= body %></p>
          </article>
        <% end %>
      </div>
      <dl class="studio-contact-details">
        <div class="studio-contact-detail"><dt class="studio-utility">Email</dt><dd><a href="mailto:hello@mwlabs.digital">hello@mwlabs.digital</a></dd></div>
        <div class="studio-contact-detail"><dt class="studio-utility">Phone</dt><dd><a href="tel:+8801704014210">+8801704014210</a></dd></div>
        <div class="studio-contact-detail"><dt class="studio-utility">Base</dt><dd>Demra, Dhaka, Bangladesh (UTC+6)</dd></div>
      </dl>
    </div>
    <div>
      <p class="studio-utility">Project enquiry / CRM routed</p>
      <%= render "home/enquiry_form", lead: @lead, source: "Website Contact Form", button_label: "Send project enquiry" %>
    </div>
  </div>
</section>
