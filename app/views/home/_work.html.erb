<section id="featured-work" class="studio-section" aria-labelledby="work-heading">
  <div class="studio-wrap">
    <div class="studio-section-head">
      <h2 id="work-heading" class="studio-section-label">04 / Selected work</h2>
      <%= link_to "All work", work_path, class: "studio-utility" %>
    </div>

    <article class="studio-work-chapter" data-work-chapter>
      <div class="studio-work-info">
        <p class="studio-utility">01 / Operational platform</p>
        <h3 class="studio-display studio-work-title">Removlo</h3>
        <p>A connected digital system for a UK removal company, from structured quotation through booking and customer updates.</p>
        <dl class="studio-work-facts">
          <div class="studio-work-fact"><dt class="studio-utility">Sector</dt><dd>Removal & logistics</dd></div>
          <div class="studio-work-fact"><dt class="studio-utility">Scope</dt><dd>Strategy, UX, platform, automation</dd></div>
          <div class="studio-work-fact"><dt class="studio-utility">Live</dt><dd><a href="https://removlo.co.uk" target="_blank" rel="noopener">removlo.co.uk</a></dd></div>
        </dl>
        <p class="studio-work-outcome">One connected quotation-to-delivery workflow.</p>
        <div class="studio-actions">
          <%= link_to "Read the case study", "/work/removal-system-design", class: "studio-button" %>
        </div>
      </div>
      <div class="studio-work-media">
        <div class="studio-browser studio-browser-removlo" role="img" aria-label="Removlo website interface study">
          <div class="studio-browser-bar">
            <span class="studio-browser-dots"><span></span><span></span><span></span></span>
            <span class="studio-utility">removlo.co.uk / live</span>
          </div>
          <div class="studio-browser-screen">
            <p class="studio-browser-brand">REMOVLO</p>
            <p class="studio-browser-headline">Moving made <em>clear.</em></p>
            <div class="studio-blueprint" aria-hidden="true"><span></span><span></span><span></span></div>
          </div>
        </div>
      </div>
    </article>

    <article class="studio-work-chapter" data-work-chapter>
      <div class="studio-work-info">
        <p class="studio-utility">02 / Lead-generation website</p>
        <h3 class="studio-display studio-work-title">Ravix Build</h3>
        <p>A premium London builders website that turns complex construction services into a focused consultation journey.</p>
        <dl class="studio-work-facts">
          <div class="studio-work-fact"><dt class="studio-utility">Sector</dt><dd>Construction</dd></div>
          <div class="studio-work-fact"><dt class="studio-utility">Scope</dt><dd>Positioning, UX, web development</dd></div>
          <div class="studio-work-fact"><dt class="studio-utility">Live</dt><dd><a href="https://ravixbuild.com" target="_blank" rel="noopener">ravixbuild.com</a></dd></div>
        </dl>
        <p class="studio-work-outcome">A premium path from first visit to consultation.</p>
        <div class="studio-actions">
          <%= link_to "See all work", work_path, class: "studio-button" %>
        </div>
      </div>
      <div class="studio-work-media">
        <div class="studio-browser studio-browser-ravix" role="img" aria-label="Ravix Build website interface study">
          <div class="studio-browser-bar">
            <span class="studio-browser-dots"><span></span><span></span><span></span></span>
            <span class="studio-utility">ravixbuild.com / live</span>
          </div>
          <div class="studio-browser-screen">
            <p class="studio-browser-brand">RAVIX BUILD</p>
            <p class="studio-browser-headline">Building spaces that increase value.</p>
            <p class="studio-utility">London / Est. 2010 / Design & build</p>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
