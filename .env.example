# Copy this file to .env.local for local development. Never put real values in
# this template and never prefix credentials with NEXT_PUBLIC_.
DATABASE_URL=mysql://mwlabs_app:replace-me@127.0.0.1:3306/mwlabs_command
SHADOW_DATABASE_URL=mysql://mwlabs_app:replace-me@127.0.0.1:3306/mwlabs_shadow
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Optional OAuth. Email/password works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only Gemini configuration. Store production values in your hosting
# provider's encrypted secret manager, never in Git or client-side variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Controls owner workspace creation only. Public prospect registration never
# grants agency access without an organization membership.
ALLOW_INITIAL_SIGNUP=false
SEED_DEMO_DATA=false
