# Copy this file to .env and replace every production value.
DATABASE_URL="mysql://mwlabs_app:mwlabs_dev_password@127.0.0.1:3306/mwlabs_command"
SHADOW_DATABASE_URL="mysql://mwlabs_app:mwlabs_dev_password@127.0.0.1:3306/mwlabs_shadow"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Optional OAuth. Email/password works without these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Server-only. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.5-flash"

# Controls owner workspace creation only. Public prospect registration remains
# available but never grants agency access without an organization membership.
ALLOW_INITIAL_SIGNUP="false"
# Keep false in production. Development can opt into sample records.
SEED_DEMO_DATA="false"
